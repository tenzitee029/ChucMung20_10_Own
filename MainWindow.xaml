<Window x:Class="ChucMung20_10.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chúc Mừng 20/10" Height="740" Width="430"
        WindowStartupLocation="CenterScreen" Background="#FFF0F5">

    <Window.Resources>
        <!-- Style cho nút bấm hiện đại -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="22" Padding="15,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style cho nút chọn Giới tính (RadioButton dạng Card) -->
        <Style x:Key="GenderRadioStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="card" Background="White" BorderBrush="#F48FB1" BorderThickness="1.5" 
                                CornerRadius="16" Padding="12,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="card" Property="Background" Value="#FCE4EC"/>
                                <Setter TargetName="card" Property="BorderBrush" Value="#E91E63"/>
                                <Setter TargetName="card" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Border CornerRadius="28" Background="White">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="5" Opacity="0.18" Color="#D81B60"/>
            </Border.Effect>

            <Grid ClipToBounds="True">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FFF5F8" Offset="0"/>
                        <GradientStop Color="#FCE4EC" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>

                <!-- Họa tiết trang trí góc -->
                <Ellipse Width="180" Height="180" Fill="#F8BBD0" Opacity="0.4" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-50,-50,0"/>
                <Ellipse Width="140" Height="140" Fill="#F48FB1" Opacity="0.3" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-40,0,0,-40"/>

                <StackPanel VerticalAlignment="Center" Margin="28">
                    <TextBlock Text="🌸 20 / 10 🌸" FontSize="34" FontWeight="Bold" Foreground="#D81B60" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="Chào mừng Ngày Phụ nữ Việt Nam" FontSize="15" FontWeight="Medium" Foreground="#880E4F" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                    <!-- 1. Nhập Họ và Tên -->
                    <TextBlock Text="Nhập Họ và Tên của bạn:" FontSize="14" FontWeight="SemiBold" Foreground="#AD1457" Margin="4,0,0,8"/>
                    <Border Background="White" CornerRadius="16" BorderBrush="#F48FB1" BorderThickness="1.5" Padding="14,10" Margin="0,0,0,4">
                        <TextBox x:Name="txtFullName" FontSize="16" BorderThickness="0" Background="Transparent" Foreground="#333" VerticalContentAlignment="Center" KeyDown="TxtFullName_KeyDown"/>
                    </Border>
                    <TextBlock Text="Nhập đầy đủ Họ và Tên, In hoa chữ cái đầu. VD: Nguyễn Thị B " FontSize="10" FontWeight="Regular" FontStyle="Italic" Foreground="#333" Margin="15,0,0,20"/>

                    <!-- 2. Chọn Giới tính (Nữ / Nam) -->
                    <TextBlock Text="Chọn giới tính:" FontSize="14" FontWeight="SemiBold" Foreground="#AD1457" Margin="4,0,0,8"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <RadioButton x:Name="radNu" Grid.Column="0" GroupName="Gender" IsChecked="True" Style="{StaticResource GenderRadioStyle}">
                            <TextBlock Text="Nữ" FontSize="15" FontWeight="Bold" Foreground="#D81B60"/>
                        </RadioButton>

                        <RadioButton x:Name="radNam" Grid.Column="2" GroupName="Gender" Style="{StaticResource GenderRadioStyle}">
                            <TextBlock Text="Nam" FontSize="15" FontWeight="Bold" Foreground="#1976D2"/>
                        </RadioButton>
                    </Grid>

                    <!-- Thông báo lỗi -->
                    <TextBlock x:Name="txtError" Text="Vui lòng nhập đầy đủ họ và tên!" Foreground="#E53935" FontSize="13" Margin="4,4,0,0" Visibility="Hidden"/>

                    <!-- 3. Nút Xác nhận & Hủy bỏ -->
                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="Xác nhận" Style="{StaticResource ModernButton}" Background="#E91E63" Height="46" Click="BtnConfirm_Click"/>
                        <Button Grid.Column="2" Content="Hủy bỏ" Style="{StaticResource ModernButton}" Background="#9E9E9E" Height="46" Click="BtnCancel_Click"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>