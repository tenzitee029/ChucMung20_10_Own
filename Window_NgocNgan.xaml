<Window x:Class="ChucMung20_10.Window_NgocNgan"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chúc Mừng 20/10 - Nguyễn Hữu Ngọc Ngân" Height="740" Width="430"
        WindowStartupLocation="CenterScreen" Background="#FFF0F5"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Storyboard x:Key="OpenCardAnim">
            <DoubleAnimation Storyboard.TargetName="MainCard" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.6"/>
            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" From="0.86" To="1" Duration="0:0:0.6">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" From="0.86" To="1" Duration="0:0:0.6">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Grid Margin="16">
        <Border x:Name="MainCard" CornerRadius="28" Background="#880E4F" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.28" Color="#D81B60"/>
            </Border.Effect>

            <Grid ClipToBounds="True">
                <Border CornerRadius="28">
                    <Border.Background>
                        <ImageBrush ImageSource="pack://application:,,,/Images/ngan.jpg" Stretch="UniformToFill"/>
                    </Border.Background>
                    <Border.Effect>
                        <BlurEffect Radius="18"/>
                    </Border.Effect>
                </Border>

                <Border CornerRadius="28">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="#44000000" Offset="0"/>
                            <GradientStop Color="#8838001A" Offset="0.5"/>
                            <GradientStop Color="#EB38001A" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Canvas x:Name="ParticleCanvas" IsHitTestVisible="False" ClipToBounds="True"/>

                <Grid Margin="24">
                    <Button Content="← Nhập lại" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Background="#55000000" Foreground="White" BorderThickness="0"
                            Padding="16,8" Cursor="Hand" FontWeight="SemiBold" Click="BtnBack_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="16"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <StackPanel VerticalAlignment="Center" Margin="0,25,0,0">
                        <Border Width="155" Height="155" CornerRadius="80" BorderBrush="White" BorderThickness="4" 
                                HorizontalAlignment="Center" Margin="0,0,0,18">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.45" Color="Black"/>
                            </Border.Effect>
                            <Border.Background>
                                <ImageBrush ImageSource="pack://application:,,,/Images/ngan.jpg" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>

                        <Border Background="#CCFF4081" CornerRadius="12" Padding="12,5" HorizontalAlignment="Center" Margin="0,0,0,10">
                            <TextBlock Text="🌸 HAPPY WOMEN'S DAY 20/10" Foreground="White" FontSize="11" FontWeight="Bold"/>
                        </Border>

                        <TextBlock Text="Nguyễn Hữu Ngọc Ngân" FontSize="25" FontWeight="Bold" Foreground="White" 
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,16">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.6"/>
                            </TextBlock.Effect>
                        </TextBlock>

                        <Border Background="#38FFFFFF" BorderBrush="#77FFFFFF" BorderThickness="1.2" CornerRadius="20" Padding="18">
                            <TextBlock Text="Nhân ngày Phụ nữ Việt Nam 20/10, chúc Ngọc Ngân luôn xinh đẹp, cười càng ngày càng to. Chúc mày luôn tràn đầy năng lượng, học tập tốt và mọi dự định sắp tới đều thành công 💖" 
                                       FontSize="15" Foreground="White" TextAlignment="Center" TextWrapping="Wrap" LineHeight="23" FontWeight="Medium"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>