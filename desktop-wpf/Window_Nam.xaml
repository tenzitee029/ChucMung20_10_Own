<Window x:Class="ChucMung20_10.Window_Nam"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lời Chúc Sức Khỏe" Height="740" Width="430"
        WindowStartupLocation="CenterScreen" Background="#E3F2FD"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Storyboard x:Key="OpenAnim">
            <DoubleAnimation Storyboard.TargetName="CardRoot" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.5"/>
            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" From="0.88" To="1" Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" From="0.88" To="1" Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Grid Margin="16">
        <Border x:Name="CardRoot" CornerRadius="28" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="5" Opacity="0.22" Color="#1565C0"/>
            </Border.Effect>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1E3C72" Offset="0"/>
                    <GradientStop Color="#2A5298" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid ClipToBounds="True" Margin="24">
                <Button Content="← Nhập lại" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Background="#44FFFFFF" Foreground="White" BorderThickness="0"
                        Padding="16,8" Cursor="Hand" FontWeight="SemiBold" Click="BtnBack_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="16"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="110" Height="110" CornerRadius="55" Background="#25FFFFFF" 
                            BorderBrush="#66FFFFFF" BorderThickness="2" Margin="0,0,0,20">
                        <TextBlock Text="😎" FontSize="54" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock x:Name="txtMaleName" Text="Chào bạn!" FontSize="26" FontWeight="Bold" 
                               Foreground="White" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <Border Background="#FFCA28" CornerRadius="12" Padding="14,6" HorizontalAlignment="Center" Margin="0,0,0,18">
                        <TextBlock Text="📢 THÔNG BÁO NHỎ" Foreground="#1E3C72" FontSize="12" FontWeight="Bold"/>
                    </Border>

                    <Border Background="#28FFFFFF" BorderBrush="#55FFFFFF" BorderThickness="1.2" CornerRadius="20" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Bạn là Nam nên hôm nay (20/10) không phải là ngày lễ dành cho bạn rồi! 😄" 
                                       FontSize="15.5" FontWeight="Bold" Foreground="#FFF59D" 
                                       TextAlignment="Center" TextWrapping="Wrap" LineHeight="23" Margin="0,0,0,12"/>

                            <TextBlock Text="Tuy nhiên, nhân dịp đặc biệt này, vẫn xin gửi đến bạn một lời chúc sức khỏe thật dồi dào, luôn giữ vững phong độ, tràn đầy năng lượng và gặp nhiều may mắn trong học tập cũng như công việc nhé! 💪✨" 
                                       FontSize="15" Foreground="White" TextAlignment="Center" TextWrapping="Wrap" LineHeight="23"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>